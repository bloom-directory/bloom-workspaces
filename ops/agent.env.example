BLOOM_PUBLIC_MODE=1
BLOOM_AGENT_SOCKET=/run/bloom-workspaces/agent.sock
BLOOM_AGENT_TOKEN=replace-with-shared-random-value-of-at-least-32-bytes
BLOOM_DATA_DIR=/var/lib/bloom-workspaces/node
BLOOM_RUNTIME_SOCKET_DIR=/run/bloom-workspaces/vm

# Start with the unprivileged QEMU systemd unit. For Firecracker, select the
# root/jailer unit template, set BLOOM_RUNTIME=firecracker and JAILED=1.
BLOOM_RUNTIME=qemu
BLOOM_FIRECRACKER_JAILED=0
BLOOM_QEMU_BIN=/usr/bin/qemu-system-x86_64
BLOOM_FIRECRACKER_BIN=/opt/bloom-workspaces/artifacts/firecracker
BLOOM_FIRECRACKER_JAILER_BIN=/opt/bloom-workspaces/artifacts/jailer
BLOOM_JAILER_CHROOT_BASE=/run/bloom-jailer
BLOOM_VM_KERNEL=/opt/bloom-workspaces/artifacts/vmlinux-6.1.155
BLOOM_VM_ROOTFS=/opt/bloom-workspaces/artifacts/bloom-alpine.ext4
BLOOM_VM_EGRESS=none
BLOOM_VM_MEMORY_MIB=512
BLOOM_VM_VCPUS=1
BLOOM_MAX_LEASE_MINUTES=30
