[Unit]
Description=Bloom Workspaces control plane
After=bloom-workspaces-agent.service
Requires=bloom-workspaces-agent.service

[Service]
Type=simple
User=bloom-control
Group=bloom-workspaces
WorkingDirectory=/opt/bloom-workspaces
EnvironmentFile=/etc/bloom-workspaces/control.env
ExecStart=/usr/bin/node /opt/bloom-workspaces/dist/server/control/main.js
Restart=always
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/bloom-workspaces/control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
