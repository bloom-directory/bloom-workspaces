BLOOM_PUBLIC_MODE=1
BLOOM_DEV_AUTH=0
BLOOM_ORIGIN=https://workspaces.example.com
BLOOM_PORT=8787
BLOOM_TRUSTED_PROXY_HOPS=1
BLOOM_DATABASE=/var/lib/bloom-workspaces/control/control.sqlite
BLOOM_AGENT_SOCKET=/run/bloom-workspaces/agent.sock
BLOOM_SESSION_SECRET=replace-with-independent-random-value-of-at-least-32-bytes
BLOOM_AGENT_TOKEN=replace-with-shared-random-value-of-at-least-32-bytes
BLOOM_TURNSTILE_SITE_KEY=replace-me
BLOOM_TURNSTILE_SECRET=replace-me
BLOOM_RUNTIME=qemu
BLOOM_FIRECRACKER_JAILED=0
BLOOM_LEASE_MINUTES=20
BLOOM_MAX_LEASE_MINUTES=30
BLOOM_MAX_RUNNING=4
BLOOM_MAX_QUEUE=40
BLOOM_MAX_ACTIVE_PER_WALLET=1
BLOOM_MAX_ACTIVE_PER_IP=1
BLOOM_DAILY_PER_WALLET=2
BLOOM_DAILY_PER_IP=3
