# Local development defaults. Never copy these values into a public deployment.
BLOOM_ORIGIN=http://127.0.0.1:8787
BLOOM_PORT=8787
BLOOM_DATABASE=./data/control.sqlite
BLOOM_AGENT_SOCKET=./data/agent.sock
BLOOM_AGENT_TOKEN=replace-with-32-random-bytes
BLOOM_SESSION_SECRET=replace-with-32-random-bytes
BLOOM_RUNTIME=process
BLOOM_DEV_AUTH=1
# Seed a mock pending ceremony request per workspace so the browser-native relay
# (approve via WebAuthn) is exercisable on the process runtime without KVM.
# Dev-only; rejected in public mode.
BLOOM_DEV_MOCK_CEREMONY=0
# Run the REAL bloom CLI on the process runtime: bloom init + a seeded staged tx,
# with the relay reading bloom's actual outbox. Most-real KVM-free mode; approval
# verification is still mocked (Slice 2). Dev-only; rejected in public mode.
BLOOM_DEV_REAL_BLOOM=0
BLOOM_PUBLIC_MODE=0

# Required when BLOOM_PUBLIC_MODE=1.
# BLOOM_ORIGIN=https://workspaces.example.com
# BLOOM_TURNSTILE_SITE_KEY=
# BLOOM_TURNSTILE_SECRET=
# BLOOM_RUNTIME=firecracker

# VM assets (created by ops/images/build-demo-image.sh).
BLOOM_VM_KERNEL=./artifacts/vmlinux-6.1.155
BLOOM_VM_ROOTFS=./artifacts/bloom-alpine.ext4
BLOOM_FIRECRACKER_BIN=./artifacts/firecracker
BLOOM_FIRECRACKER_JAILER_BIN=./artifacts/jailer
BLOOM_FIRECRACKER_JAILED=0
BLOOM_JAILER_CHROOT_BASE=/run/bloom-jailer
BLOOM_RUNTIME_SOCKET_DIR=/run/bloom-workspaces/vm
BLOOM_QEMU_BIN=qemu-system-x86_64
# Path to the bloom CLI. On the host, point at the built static binary:
#   ops/bloom/artifacts/v0.1.3-x86_64-musl/bloom
BLOOM_BLOOM_BIN=bloom
BLOOM_VM_MEMORY_MIB=512
BLOOM_VM_VCPUS=1
BLOOM_VM_EGRESS=none
BLOOM_PERSISTENCE_ENABLED=1
BLOOM_SSH_ENABLED=0
# BLOOM_SSH_CA_KEY=/absolute/path/to/workspace-ca
# BLOOM_SSH_MAX_LEASE_MINUTES=15
BLOOM_NFS_ENABLED=0
# BLOOM_NFS_KERNEL_CONFIG=./artifacts/nfs-kernel/vmlinux-6.1.155-nfsd.config
# Storage quota for workspace volumes in MiB (16–5120, default 512).
# BLOOM_STORAGE_QUOTA_MIB=512
# Comma-separated list of Bloom Petals to pre-install in every workspace.
# Default is empty (no auto-installed Petals). Users can still `bloom install`
# explicitly from the terminal (subject to the egress proxy allowlist).
# Max 32 entries, alphanumeric/dash/underscore only.
# BLOOM_PREINSTALLED_PETALS=gasless,enso
# Set controlled for the curated public package allowlist. Raw internet mode is
# rejected in public deployments.
# BLOOM_VM_EGRESS=controlled
# BLOOM_EGRESS_ALLOWED_HOSTS=registry.npmjs.org,*.npmjs.org,pypi.org,files.pythonhosted.org
# BLOOM_EGRESS_MAX_CONNECTIONS=32
# BLOOM_EGRESS_MAX_MIB_PER_CONNECTION=128
# BLOOM_EGRESS_CONNECTION_SECONDS=300
